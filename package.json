{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vitest run",
    "test:home-performance": "npm run build && tsx scripts/run-home-performance-tests.ts",
    "benchmark:home-data": "tsx scripts/measure-home-data.ts",
    "benchmark:home-before-after": "tsx scripts/compare-home-performance.ts --write",
    "test:watch": "vitest",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "content:generate": "tsx scripts/generate-system-content.ts",
    "content:qwen": "tsx scripts/run-qwen-content-agent.ts",
    "content:qwen:local": "tsx scripts/run-local-qwen-content-agent.ts",
    "content:repair": "tsx scripts/repair-reorganized-content.ts",
    "content:audit-scenarios": "tsx scripts/audit-reorganized-scenarios.ts",
    "content:checkpoint:import": "tsx scripts/import-qwen-checkpoint.ts",
    "content:publish": "tsx scripts/publish-qwen-content.ts",
    "content:review": "tsx scripts/run-local-content-review.ts",
    "content:release:approved": "tsx scripts/release-approved-qwen-content.ts",
    "db:generate": "drizzle-kit generate"
    ,"account:create": "tsx scripts/manage-account.ts create"
    ,"account:reset": "tsx scripts/manage-account.ts reset"
    ,"account:disable": "tsx scripts/manage-account.ts disable"
    ,"account:enable": "tsx scripts/manage-account.ts enable"
    ,"account:list": "tsx scripts/manage-account.ts list"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "idb": "^8.0.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "16.4.0",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
